# Elgato Facecam (1st gen, 0fd9:0078): repair uvcvideo initialisation and map the extension unit.
# When it enumerates, the camera stalls (-32) many of the GET_DEF/GET_CUR requests uvcvideo sends
# while registering controls, and uvcvideo silently drops those controls (seen: 5 of 10, or 0 of 10).
# A later re-bind recovers all of them. The helper runs deferred via systemd-run so udev is not blocked.
# USB autosuspend is disabled: after a runtime suspend (2 s after the last user) the camera restarts,
# reloads its stored settings (losing any change made since) and stalls requests while it boots.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0fd9", ATTR{idProduct}=="0078", ATTR{power/control}="on", RUN+="/usr/bin/systemd-run --no-block --collect --on-active=10 /usr/local/libexec/obtura-init %k"
