#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Run by 99-obtura.rules with the USB device name (e.g. 6-2) as argument.
# 1. If uvcvideo lost controls during enumeration, re-bind it (USB reset) until all 10 are there.
# 2. Map the Elgato extension unit as V4L2 controls (obtura map-controls); the mapping is lost
#    on every bind, so it has to run after step 1.
# 3. Disable USB autosuspend again: uvcvideo re-enables it on every bind (seen after a re-bind,
#    and our own re-binds happen on most boots), overriding ATTR{power/control}="on".
# EXPECTED_CTRLS can be overridden from the environment to test the reset path by hand.
set -uo pipefail

DEV="$1"
INTF="${DEV}:1.0"
DRV="/sys/bus/usb/drivers/uvcvideo"
EXPECTED="${EXPECTED_CTRLS:-10}"
MAX_TRIES=3
TAG=obtura

video_node() {
    local node
    for node in /sys/bus/usb/devices/"$INTF"/video4linux/video*; do
        [ "$(cat "$node/index" 2>/dev/null)" = "0" ] && { echo "/dev/$(basename "$node")"; return; }
    done
}

count_ctrls() {
    local dev
    dev=$(video_node)
    [ -n "$dev" ] || { echo 0; return; }
    # While idle the camera sometimes stalls GET_CUR on a control that does exist; v4l2-ctl then
    # prints "error .. getting ext_ctrl" instead of the control line, which also counts as present.
    # Controls added by map-controls (0x009a099x, or by name on an error line) are not counted.
    /usr/bin/v4l2-ctl -d "$dev" --list-ctrls 2>&1 \
        | grep -vE ' 0x009a099|ext_ctrl (Shutter Speed|AE Metering|Noise Reduction)$' | grep -cE ' 0x009|getting ext_ctrl'
}

keep_awake() {
    echo on > /sys/bus/usb/devices/"$DEV"/power/control 2>/dev/null \
        || logger -t "$TAG" "Facecam ${DEV}: could not disable USB autosuspend"
}

map_xu() {
    local out
    if out=$(/usr/local/bin/obtura --device "$(video_node)" map-controls 2>&1); then
        logger -t "$TAG" "Facecam ${DEV}: extension unit mapped (Shutter Speed, AE Metering, Noise Reduction)"
    else
        logger -t "$TAG" "Facecam ${DEV}: mapping the extension unit failed: $(echo "$out" | grep -m3 ERROR | tr '\n' ' ')"
    fi
}

for try in $(seq 1 "$MAX_TRIES"); do
    n=$(count_ctrls)
    if [ "$n" -ge "$EXPECTED" ]; then
        logger -t "$TAG" "Facecam ${DEV}: ${n} V4L2 controls, OK (attempt ${try})"
        map_xu
        keep_awake
        exit 0
    fi
    logger -t "$TAG" "Facecam ${DEV}: only ${n}/${EXPECTED} V4L2 controls, re-binding uvcvideo (attempt ${try}/${MAX_TRIES})"
    echo "$INTF" > "$DRV/unbind" 2>/dev/null
    sleep 2
    echo "$INTF" > "$DRV/bind"
    sleep 5
done

logger -t "$TAG" "Facecam ${DEV}: controls still missing after ${MAX_TRIES} attempts ($(count_ctrls)/${EXPECTED})"
keep_awake
exit 1
